{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huangrx6/SpecForge/core/skills/ui-ux/design-system/contracts/design-contract.schema.json",
  "title": "SpecForge Design Contract Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scan_manifest",
    "design_mode",
    "aesthetic_direction",
    "signature",
    "color_system",
    "foundation_system",
    "token_source",
    "component_strategy",
    "shadcn_vue",
    "motion",
    "verification_hooks",
    "anti_slop_rules"
  ],
  "properties": {
    "scan_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "scanned_files", "selected_data", "skipped_with_reason"],
      "properties": {
        "workflow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "mode",
              "intelligence",
              "source",
              "font",
              "color",
              "composition",
              "advanced_interaction",
              "component",
              "qa",
              "calibration",
              "output"
            ]
          }
        },
        "scanned_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "purpose", "status", "finding"],
            "properties": {
              "path": { "type": "string" },
              "purpose": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["scanned", "skipped", "blocked"]
              },
              "finding": { "type": "string" }
            }
          }
        },
        "selected_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "palette_id",
            "font_source_id",
            "font_pairing_id",
            "type_scale_id",
            "spacing_density_id",
            "radius_shadow_recipe_id",
            "motion_recipe_id",
            "advanced_interaction_recipe_id"
          ],
          "properties": {
            "palette_id": { "type": "string" },
            "font_source_id": { "type": "string" },
            "font_pairing_id": { "type": "string" },
            "type_scale_id": { "type": "string" },
            "spacing_density_id": { "type": "string" },
            "radius_shadow_recipe_id": { "type": "string" },
            "motion_recipe_id": { "type": "string" },
            "advanced_interaction_recipe_id": { "type": "string" }
          }
        },
        "skipped_with_reason": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "design_mode": {
      "type": "string",
      "enum": ["Product UI", "Brand Surface", "Hybrid", "Avatar-IP", "Empty State"]
    },
    "scope": {
      "type": "string",
      "enum": ["avatar", "empty_state", "both"]
    },
    "aesthetic_direction": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["structural", "typographic", "material", "interaction", "motion"]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "token_source": {
      "type": "string",
      "enum": ["existing", "new", "delta"]
    },
    "color_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette_id",
        "aesthetic_direction",
        "design_mode",
        "tokens",
        "usage_rules",
        "accessibility",
        "source",
        "source_url",
        "license_note"
      ],
      "properties": {
        "palette_id": { "type": "string" },
        "aesthetic_direction": { "type": "string" },
        "design_mode": {
          "type": "string",
          "enum": ["Product UI", "Brand Surface", "Hybrid", "Avatar-IP", "Empty State"]
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "surface",
            "surface_muted",
            "text",
            "text_muted",
            "primary",
            "secondary",
            "accent",
            "border",
            "success",
            "warning",
            "danger",
            "chart"
          ],
          "properties": {
            "background": { "type": "string" },
            "surface": { "type": "string" },
            "surface_muted": { "type": "string" },
            "text": { "type": "string" },
            "text_muted": { "type": "string" },
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "accent": { "type": "string" },
            "border": { "type": "string" },
            "success": { "type": "string" },
            "warning": { "type": "string" },
            "danger": { "type": "string" },
            "chart": {
              "type": "array",
              "minItems": 3,
              "items": { "type": "string" }
            }
          }
        },
        "usage_rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_usage", "accent_usage", "background_usage", "avoid"],
          "properties": {
            "primary_usage": { "type": "string" },
            "accent_usage": { "type": "string" },
            "background_usage": { "type": "string" },
            "avoid": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requires_contrast_check", "dark_mode_ready", "contrast_checks"],
          "properties": {
            "requires_contrast_check": { "type": "boolean" },
            "dark_mode_ready": { "type": "boolean" },
            "contrast_checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pair", "ratio", "status"],
                "properties": {
                  "pair": { "type": "string" },
                  "ratio": { "type": "string" },
                  "status": {
                    "type": "string",
                    "enum": ["pass", "fail", "not-checked"]
                  }
                }
              }
            }
          }
        },
        "source": { "type": "string" },
        "source_url": { "type": "string" },
        "license_note": { "type": "string" }
      }
    },
    "foundation_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_basis", "typography", "spacing", "radius_shadow", "motion"],
      "properties": {
        "source_basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "adopt", "adapt", "avoid"],
            "properties": {
              "source": { "type": "string" },
              "adopt": { "type": "string" },
              "adapt": { "type": "string" },
              "avoid": { "type": "string" }
            }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["font_family", "scale", "line_height", "numeric", "usage_rules"],
          "properties": {
            "font_family": { "type": "string" },
            "scale": { "type": "string" },
            "line_height": { "type": "string" },
            "numeric": { "type": "string" },
            "usage_rules": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["density", "grid", "page_padding", "section_gap", "component_gap", "usage_rules"],
          "properties": {
            "density": {
              "type": "string",
              "enum": [
                "compact",
                "comfortable",
                "analytical",
                "editorial",
                "hybrid",
                "productive-2x",
                "commerce-admin",
                "collaboration-workflow",
                "fluent-ramp",
                "material-adaptive",
                "brand-narrative"
              ]
            },
            "grid": { "type": "string" },
            "page_padding": { "type": "string" },
            "section_gap": { "type": "string" },
            "component_gap": { "type": "string" },
            "usage_rules": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "radius_shadow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["radius_scale", "surface_treatment", "overlay_shadow", "usage_rules"],
          "properties": {
            "radius_scale": { "type": "string" },
            "surface_treatment": { "type": "string" },
            "overlay_shadow": { "type": "string" },
            "usage_rules": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["motion_personality", "css_tokens", "gsap_signature", "reduced_motion"],
          "properties": {
            "motion_personality": { "type": "string" },
            "css_tokens": {
              "type": "array",
              "items": { "type": "string" }
            },
            "gsap_signature": { "type": "string" },
            "reduced_motion": { "type": "string" }
          }
        }
      }
    },
    "component_strategy": {
      "type": "string",
      "enum": ["primitive + wrapper", "project components", "registry"]
    },
    "shadcn_vue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive_layer", "project_wrapper_layer"],
      "properties": {
        "primitive_layer": {
          "type": "array",
          "items": { "type": "string" }
        },
        "project_wrapper_layer": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_1_css", "layer_2_motion_vue", "layer_3_gsap", "reduced_motion"],
      "properties": {
        "layer_1_css": {
          "type": "array",
          "items": { "type": "string" }
        },
        "layer_2_motion_vue": {
          "type": "array",
          "items": { "type": "string" }
        },
        "layer_3_gsap": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reduced_motion": {
          "type": "string"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigation_decision",
        "layout_archetype",
        "primary_work_surface",
        "scroll_regions",
        "responsive_strategy"
      ],
      "properties": {
        "navigation_decision": { "type": "string" },
        "layout_archetype": { "type": "string" },
        "primary_work_surface": { "type": "string" },
        "scroll_regions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "responsive_strategy": { "type": "string" }
      }
    },
    "state_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_states", "owner"],
      "properties": {
        "required_states": {
          "type": "array",
          "items": { "type": "string" }
        },
        "owner": { "type": "string" }
      }
    },
    "product_ui_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_user",
        "primary_object",
        "primary_job",
        "kpi_actionability",
        "content_budget",
        "right_rail_purpose",
        "rejected_filler"
      ],
      "properties": {
        "primary_user": { "type": "string" },
        "primary_object": { "type": "string" },
        "primary_job": { "type": "string" },
        "kpi_actionability": {
          "type": "string",
          "enum": ["pass", "issue", "not-applicable"]
        },
        "content_budget": {
          "type": "string",
          "enum": ["pass", "issue", "not-applicable"]
        },
        "right_rail_purpose": { "type": "string" },
        "rejected_filler": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "visual_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback_source", "diagnosis", "palette_delta", "anti_reference", "next_review"],
      "properties": {
        "feedback_source": { "type": "string" },
        "diagnosis": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issue", "evidence", "affected_layers", "fix", "status"],
            "properties": {
              "issue": { "type": "string" },
              "evidence": { "type": "string" },
              "affected_layers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "color",
                    "typography",
                    "spacing",
                    "surface",
                    "layout",
                    "motion",
                    "advanced_interaction",
                    "content",
                    "signature"
                  ]
                }
              },
              "fix": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["pending", "fixed", "accepted", "blocked"]
              }
            }
          }
        },
        "palette_delta": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "from", "to", "reason"],
            "properties": {
              "field": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "anti_reference": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next_review": { "type": "string" }
      }
    },
    "verification_hooks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "anti_slop_rules": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
