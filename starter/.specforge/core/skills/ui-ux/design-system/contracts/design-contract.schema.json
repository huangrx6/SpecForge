{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huangrx6/SpecForge/core/skills/ui-ux/design-system/contracts/design-contract.schema.json",
  "title": "SpecForge Design Contract Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "design_mode",
    "aesthetic_direction",
    "signature",
    "color_system",
    "token_source",
    "component_strategy",
    "shadcn_vue",
    "motion",
    "verification_hooks",
    "anti_slop_rules"
  ],
  "properties": {
    "design_mode": {
      "type": "string",
      "enum": ["Product UI", "Brand Surface", "Hybrid", "Avatar-IP", "Empty State"]
    },
    "scope": {
      "type": "string",
      "enum": ["avatar", "empty_state", "both"]
    },
    "aesthetic_direction": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["structural", "typographic", "material", "interaction", "motion"]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "token_source": {
      "type": "string",
      "enum": ["existing", "new", "delta"]
    },
    "color_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette_id",
        "aesthetic_direction",
        "design_mode",
        "tokens",
        "usage_rules",
        "accessibility",
        "source",
        "source_url",
        "license_note"
      ],
      "properties": {
        "palette_id": { "type": "string" },
        "aesthetic_direction": { "type": "string" },
        "design_mode": {
          "type": "string",
          "enum": ["Product UI", "Brand Surface", "Hybrid", "Avatar-IP", "Empty State"]
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "surface",
            "surface_muted",
            "text",
            "text_muted",
            "primary",
            "secondary",
            "accent",
            "border",
            "success",
            "warning",
            "danger",
            "chart"
          ],
          "properties": {
            "background": { "type": "string" },
            "surface": { "type": "string" },
            "surface_muted": { "type": "string" },
            "text": { "type": "string" },
            "text_muted": { "type": "string" },
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "accent": { "type": "string" },
            "border": { "type": "string" },
            "success": { "type": "string" },
            "warning": { "type": "string" },
            "danger": { "type": "string" },
            "chart": {
              "type": "array",
              "minItems": 3,
              "items": { "type": "string" }
            }
          }
        },
        "usage_rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_usage", "accent_usage", "background_usage", "avoid"],
          "properties": {
            "primary_usage": { "type": "string" },
            "accent_usage": { "type": "string" },
            "background_usage": { "type": "string" },
            "avoid": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requires_contrast_check", "dark_mode_ready", "contrast_checks"],
          "properties": {
            "requires_contrast_check": { "type": "boolean" },
            "dark_mode_ready": { "type": "boolean" },
            "contrast_checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pair", "ratio", "status"],
                "properties": {
                  "pair": { "type": "string" },
                  "ratio": { "type": "string" },
                  "status": {
                    "type": "string",
                    "enum": ["pass", "fail", "not-checked"]
                  }
                }
              }
            }
          }
        },
        "source": { "type": "string" },
        "source_url": { "type": "string" },
        "license_note": { "type": "string" }
      }
    },
    "component_strategy": {
      "type": "string",
      "enum": ["primitive + wrapper", "project components", "registry"]
    },
    "shadcn_vue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive_layer", "project_wrapper_layer"],
      "properties": {
        "primitive_layer": {
          "type": "array",
          "items": { "type": "string" }
        },
        "project_wrapper_layer": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_1_css", "layer_2_motion_vue", "layer_3_gsap", "reduced_motion"],
      "properties": {
        "layer_1_css": {
          "type": "array",
          "items": { "type": "string" }
        },
        "layer_2_motion_vue": {
          "type": "array",
          "items": { "type": "string" }
        },
        "layer_3_gsap": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reduced_motion": {
          "type": "string"
        }
      }
    },
    "verification_hooks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "anti_slop_rules": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
