{
  "name": "specforge",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "scripts": {
    "validate": "node runtime/execution/tools/validate-structure.mjs",
    "status": "node runtime/execution/tools/status.mjs",
    "graph:status": "node runtime/execution/tools/artifact-graph-status.mjs",
    "new:change": "node runtime/execution/tools/create-change.mjs",
    "new:artifact": "node runtime/execution/tools/create-artifact.mjs",
    "instructions": "node runtime/execution/tools/instructions.mjs",
    "gate": "node runtime/execution/tools/gate.mjs",
    "archive": "node runtime/execution/tools/archive-change.mjs",
    "selftest": "node runtime/execution/tools/self-test.mjs",
    "doctor": "node runtime/execution/tools/doctor.mjs",
    "validate:skills": "node runtime/execution/tools/validate-skills.mjs",
    "sync:codex-skills": "node runtime/execution/tools/sync-codex-skills.mjs",
    "sync:starter": "node runtime/execution/tools/sync-starter-assets.mjs",
    "check:starter": "node runtime/execution/tools/sync-starter-assets.mjs --check",
    "install:skills": "node cli/specforge.mjs skill add --target all --apply --prune-legacy",
    "skill:add": "node cli/specforge.mjs skill add",
    "init": "node cli/specforge.mjs init"
  },
  "license": "MIT",
  "description": "SpecForge: repository-native Spec-Driven Development workflow for AI agents.",
  "bin": {
    "specforge": "cli/specforge.mjs"
  },
  "files": [
    "cli",
    "runtime",
    "starter",
    "skills",
    "docs/README.md",
    "docs/AGENTS.md",
    "docs/CLAUDE.md",
    "docs/CHANGELOG.md",
    "docs/adapters",
    "docs/agents"
  ]
}
