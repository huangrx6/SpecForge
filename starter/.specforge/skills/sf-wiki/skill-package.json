{
  "version": 2,
  "id": "sf-wiki",
  "layer": "delivery-gates",
  "primary_stage": "wiki-sync",
  "purpose": "Sync long-lived project facts into .specforge/wiki.",
  "owns": {
    "stages": [
      {
        "stage": "wiki-sync",
        "path": "stages/wiki-sync/SKILL.md"
      }
    ],
    "workflow": []
  },
  "uses": {
    "stages": [
      {
        "stage": "steering",
        "owner": "sf-steering",
        "path": "../sf-steering/stages/steering/SKILL.md"
      }
    ],
    "workflow": [
      {
        "owner": "sf-router",
        "path": "../sf-router/workflow/README.md"
      }
    ]
  },
  "commands": "commands.json"
}
