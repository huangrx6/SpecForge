{
  "id": "discovery",
  "version": 1,
  "description": "探索与技术预研流程，仅输出研究成果，不实施代码。",
  "artifacts": [
    {
      "id": "intake",
      "stage": "00-intake",
      "title": "预研入口",
      "description": "记录调研目标",
      "outputs": [
        "00-intake/original-request.md",
        "00-intake/brief.md"
      ],
      "requires": []
    },
    {
      "id": "research",
      "stage": "01-spec",
      "title": "调研报告",
      "description": "实验记录与可行性分析",
      "outputs": [
        "01-spec/research.md"
      ],
      "requires": [
        "intake"
      ]
    },
    {
      "id": "wiki_sync",
      "stage": "06-close",
      "title": "知识回流",
      "description": "提炼入项目知识库",
      "outputs": [
        "06-close/wiki-sync.md"
      ],
      "requires": [
        "research"
      ],
      "gate": "wiki_sync"
    },
    {
      "id": "closure",
      "stage": "06-close",
      "title": "关闭记录",
      "description": "归档",
      "outputs": [
        "06-close/release.md",
        "06-close/rollback.md"
      ],
      "requires": [
        "wiki_sync"
      ]
    }
  ],
  "apply": {
    "requires": [],
    "tracks": null
  },
  "archive": {
    "requires": [
      "wiki_sync",
      "closure"
    ]
  },
  "traceability_policy": {
    "mode": "off",
    "enforced_gates": []
  },
  "quality_policy": {
    "section_checks": [
      {
        "artifact": "research",
        "path": "01-spec/research.md",
        "sections": [
          "来源质量分级",
          "ADR 摘要"
        ],
        "severity": "P2",
        "message": "research.md 缺少来源质量分级或 ADR 摘要，后续方案可能无法区分官方证据、推断和长期决策。"
      },
      {
        "artifact": "wiki_sync",
        "path": "06-close/wiki-sync.md",
        "sections": [
          "派生报告索引"
        ],
        "severity": "P3",
        "message": "wiki-sync.md 缺少派生报告索引，HTML / 图表等辅助产物的后续追踪可能不完整。"
      },
      {
        "artifact": "closure",
        "path": "06-close/release.md",
        "sections": [
          "外部补证与派生报告"
        ],
        "severity": "P3",
        "message": "release.md 缺少外部补证与派生报告记录，manual-confirmed / deferred 项可能没有发布后观察承接。"
      }
    ]
  }
}
