{
  "version": 2,
  "id": "sf-close",
  "layer": "delivery-gates",
  "primary_stage": "closure",
  "purpose": "Finalize wiki sync, release, rollback, doctor checks, and archive.",
  "owns": {
    "stages": [
      {
        "stage": "closure",
        "path": "stages/closure/SKILL.md"
      }
    ],
    "workflow": []
  },
  "uses": {
    "stages": [
      {
        "stage": "wiki-sync",
        "owner": "sf-wiki",
        "path": "../sf-wiki/stages/wiki-sync/SKILL.md"
      }
    ],
    "workflow": [
      {
        "owner": "sf-router",
        "path": "../sf-router/workflow/README.md"
      }
    ]
  },
  "commands": "commands.json"
}
