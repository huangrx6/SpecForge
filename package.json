{
  "name": "specforge",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "scripts": {
    "validate": "node core/scripts/validate-structure.mjs && node core/scripts/sync-agent-skills.mjs --check",
    "status": "node core/scripts/status.mjs",
    "graph:status": "node core/scripts/artifact-graph-status.mjs",
    "new:work": "node core/scripts/create-work.mjs",
    "new:artifact": "node core/scripts/create-artifact.mjs",
    "instructions": "node core/scripts/instructions.mjs",
    "gate": "node core/scripts/gate.mjs",
    "archive": "node core/scripts/archive-work.mjs",
    "codebase:map": "node core/scripts/codebase-map.mjs",
    "codebase:index": "node core/scripts/codebase-index.mjs",
    "selftest": "node core/scripts/self-test.mjs",
    "doctor": "node core/scripts/doctor.mjs",
    "validate:skills": "node core/scripts/validate-skills.mjs",
    "validate:external-skills": "node core/scripts/validate-external-skills.mjs",
    "sync:agent-skills": "node core/scripts/sync-agent-skills.mjs",
    "sync:starter": "node core/scripts/sync-starter.mjs",
    "sync:wiki": "node core/scripts/sync-wiki.mjs",
    "update:skills": "node core/scripts/update-skills.mjs --all",
    "check:skills": "node core/scripts/update-skills.mjs --check --all",
    "check:agent-skills": "node core/scripts/sync-agent-skills.mjs --check",
    "check:starter": "node core/scripts/sync-starter.mjs --check",
    "install:skills": "npx skills add .",
    "skill:add": "npx skills add .",
    "install:skills:legacy": "node cli/specforge.mjs skill add --target all --scope user --apply",
    "init": "node cli/specforge.mjs init"
  },
  "license": "MIT",
  "description": "SpecForge: repository-native Spec-Driven Development workflow for AI agents.",
  "bin": {
    "specforge": "cli/specforge.mjs"
  },
  "files": [
    "cli",
    "skills",
    "core",
    "starter",
    "agent-skills"
  ]
}
