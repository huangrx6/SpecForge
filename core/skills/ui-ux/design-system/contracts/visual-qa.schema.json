{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huangrx6/SpecForge/core/skills/ui-ux/design-system/contracts/visual-qa.schema.json",
  "title": "SpecForge Design Visual QA",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["detector", "result", "severity", "evidence", "fix", "status", "owner"],
    "properties": {
      "detector": { "type": "string", "minLength": 1 },
      "result": {
        "type": "string",
        "enum": ["ok", "issue", "not-applicable"]
      },
      "severity": {
        "type": "string",
        "enum": ["low", "medium", "high"]
      },
      "evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "viewport", "region"],
        "properties": {
          "artifact": { "type": "string", "minLength": 1 },
          "viewport": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 }
        }
      },
      "fix": { "type": "string" },
      "status": {
        "type": "string",
        "enum": ["fixed", "accepted", "pending", "blocked", "not-applicable"]
      },
      "owner": { "type": "string", "minLength": 1 }
    }
  }
}
