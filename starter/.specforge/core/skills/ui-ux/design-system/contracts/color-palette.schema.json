{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huangrx6/SpecForge/core/skills/ui-ux/design-system/contracts/color-palette.schema.json",
  "title": "SpecForge Color Palette Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "palette_id",
    "aesthetic_direction",
    "design_mode",
    "tokens",
    "usage_rules",
    "accessibility",
    "source",
    "source_url",
    "license_note"
  ],
  "properties": {
    "palette_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "aesthetic_direction": {
      "type": "string",
      "minLength": 1
    },
    "design_mode": {
      "type": "string",
      "enum": ["Product UI", "Brand Surface", "Hybrid", "Avatar-IP", "Empty State"]
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "surface",
        "surface_muted",
        "text",
        "text_muted",
        "primary",
        "secondary",
        "accent",
        "border",
        "success",
        "warning",
        "danger",
        "chart"
      ],
      "properties": {
        "background": { "$ref": "#/$defs/hex" },
        "surface": { "$ref": "#/$defs/hexOrAlphaHex" },
        "surface_muted": { "$ref": "#/$defs/hexOrAlphaHex" },
        "text": { "$ref": "#/$defs/hex" },
        "text_muted": { "$ref": "#/$defs/hex" },
        "primary": { "$ref": "#/$defs/hex" },
        "secondary": { "$ref": "#/$defs/hexOrAlphaHex" },
        "accent": { "$ref": "#/$defs/hex" },
        "border": { "$ref": "#/$defs/hexOrAlphaHex" },
        "success": { "$ref": "#/$defs/hex" },
        "warning": { "$ref": "#/$defs/hex" },
        "danger": { "$ref": "#/$defs/hex" },
        "chart": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/hex" }
        }
      }
    },
    "usage_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_usage", "accent_usage", "background_usage", "avoid"],
      "properties": {
        "primary_usage": { "type": "string", "minLength": 1 },
        "accent_usage": { "type": "string", "minLength": 1 },
        "background_usage": { "type": "string", "minLength": 1 },
        "avoid": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_contrast_check", "dark_mode_ready", "contrast_checks"],
      "properties": {
        "requires_contrast_check": { "type": "boolean" },
        "dark_mode_ready": { "type": "boolean" },
        "contrast_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pair", "ratio", "status"],
            "properties": {
              "pair": { "type": "string" },
              "ratio": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["pass", "fail", "not-checked"]
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "license_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "hexOrAlphaHex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
    }
  }
}
