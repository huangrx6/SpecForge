{
  "id": "bugfix",
  "version": 1,
  "description": "缺陷修复流程，注重根因分析(Gap Report)而非功能需求。",
  "artifacts": [
    {
      "id": "intake",
      "stage": "00-intake",
      "title": "缺陷入口",
      "description": "记录 Bug 现象",
      "outputs": [
        "00-intake/original-request.md",
        "00-intake/brief.md"
      ],
      "requires": []
    },
    {
      "id": "gap_report",
      "stage": "01-spec",
      "title": "根因分析",
      "description": "分析为何出现缺陷及修复方案",
      "outputs": [
        "01-spec/gap-report.md"
      ],
      "requires": [
        "intake"
      ]
    },
    {
      "id": "tasks",
      "stage": "01-spec",
      "title": "修复任务",
      "description": "修复执行步骤",
      "outputs": [
        "01-spec/tasks.md"
      ],
      "requires": [
        "gap_report"
      ]
    },
    {
      "id": "implementation",
      "stage": "03-implementation",
      "title": "实现记录",
      "description": "记录变更",
      "outputs": [
        "03-implementation/plan.md",
        "03-implementation/report.md",
        "03-implementation/changed-files.md"
      ],
      "requires": [
        "tasks"
      ]
    },
    {
      "id": "code_review",
      "stage": "04-code-review",
      "title": "代码审查",
      "description": "确认代码质量",
      "outputs": [
        "04-code-review/code-review-v1.md"
      ],
      "requires": [
        "implementation"
      ],
      "gate": "code_review"
    },
    {
      "id": "verification",
      "stage": "05-verification",
      "title": "验证证据",
      "description": "复测缺陷是否被修复且无回归",
      "outputs": [
        "05-verification/report.md",
        "05-verification/ci-result.md"
      ],
      "requires": [
        "code_review"
      ],
      "gate": "verification"
    },
    {
      "id": "wiki_sync",
      "stage": "06-close",
      "title": "知识回流",
      "description": "更新长期知识",
      "outputs": [
        "06-close/wiki-sync.md"
      ],
      "requires": [
        "verification"
      ],
      "gate": "wiki_sync"
    },
    {
      "id": "closure",
      "stage": "06-close",
      "title": "关闭记录",
      "description": "归档",
      "outputs": [
        "06-close/release.md",
        "06-close/rollback.md"
      ],
      "requires": [
        "wiki_sync"
      ]
    }
  ],
  "apply": {
    "requires": [
      "tasks"
    ],
    "tracks": "01-spec/tasks.md"
  },
  "archive": {
    "requires": [
      "verification",
      "wiki_sync",
      "closure"
    ]
  },
  "quality_policy": {
    "section_checks": [
      {
        "artifact": "gap_report",
        "path": "01-spec/gap-report.md",
        "sections": [
          "证据与复现记录",
          "根因追踪",
          "规格缺口反思"
        ],
        "severity": "P2",
        "message": "gap-report.md 缺少复现证据、根因追踪或规格缺口反思，修复任务可能只处理症状而不是根因。"
      },
      {
        "artifact": "tasks",
        "path": "01-spec/tasks.md",
        "sections": [
          "一页摘要",
          "任务图与执行策略"
        ],
        "severity": "P2",
        "message": "tasks.md 缺少任务图与执行策略，多 agent / 并行实现时容易产生写入边界冲突。"
      },
      {
        "artifact": "implementation",
        "path": "03-implementation/report.md",
        "sections": [
          "任务图执行对账"
        ],
        "severity": "P2",
        "message": "implementation report 缺少任务图执行对账，code review 难以判断实际实现顺序和并行边界是否符合 tasks。"
      },
      {
        "artifact": "code_review",
        "path": "04-code-review/code-review-v1.md",
        "sections": [
          "一页摘要",
          "任务图对账",
          "验证提示"
        ],
        "severity": "P2",
        "message": "code review 缺少任务图对账或验证提示，verification 可能拿不到弱证据、deferred 项和外部补证提示。"
      },
      {
        "artifact": "verification",
        "path": "05-verification/report.md",
        "sections": [
          "一页摘要",
          "证据强度分级",
          "人工确认与外部补证"
        ],
        "severity": "P2",
        "message": "verification report 缺少证据强度分级或人工确认记录，gate 风险接受依据不够清楚。"
      },
      {
        "artifact": "wiki_sync",
        "path": "06-close/wiki-sync.md",
        "sections": [
          "派生报告索引"
        ],
        "severity": "P3",
        "message": "wiki-sync.md 缺少派生报告索引，HTML / 图表等辅助产物的后续追踪可能不完整。"
      },
      {
        "artifact": "closure",
        "path": "06-close/release.md",
        "sections": [
          "外部补证与派生报告"
        ],
        "severity": "P3",
        "message": "release.md 缺少外部补证与派生报告记录，manual-confirmed / deferred 项可能没有发布后观察承接。"
      }
    ]
  }
}
