{
  "id": "feature",
  "version": 1,
  "description": "标准的新功能流程，强调整体的发现、设计与验证。",
  "artifacts": [
    {
      "id": "intake",
      "stage": "00-intake",
      "title": "需求入口",
      "description": "记录请求背景",
      "outputs": [
        "00-intake/original-request.md",
        "00-intake/brief.md"
      ],
      "requires": []
    },
    {
      "id": "requirements",
      "stage": "01-spec",
      "title": "需求规格",
      "description": "沉淀业务边界与功能列表",
      "outputs": [
        "01-spec/requirements.md"
      ],
      "requires": [
        "intake"
      ]
    },
    {
      "id": "design",
      "stage": "01-spec",
      "title": "技术与体验设计",
      "description": "架构设计、交互原型与数据库规划",
      "outputs": [
        "01-spec/design.md"
      ],
      "requires": [
        "requirements"
      ]
    },
    {
      "id": "tasks",
      "stage": "01-spec",
      "title": "任务拆解",
      "description": "开发任务流",
      "outputs": [
        "01-spec/tasks.md"
      ],
      "requires": [
        "design"
      ]
    },
    {
      "id": "spec_review",
      "stage": "02-spec-review",
      "title": "规格审查",
      "description": "确认架构和需求的合理性",
      "outputs": [
        "02-spec-review/spec-review-v1.md"
      ],
      "requires": [
        "requirements",
        "design",
        "tasks"
      ],
      "gate": "spec_review"
    },
    {
      "id": "implementation",
      "stage": "03-implementation",
      "title": "实现记录",
      "description": "代码编写日志",
      "outputs": [
        "03-implementation/plan.md",
        "03-implementation/report.md",
        "03-implementation/changed-files.md"
      ],
      "requires": [
        "spec_review"
      ]
    },
    {
      "id": "code_review",
      "stage": "04-code-review",
      "title": "代码审查",
      "description": "安全与规范门禁",
      "outputs": [
        "04-code-review/code-review-v1.md"
      ],
      "requires": [
        "implementation"
      ],
      "gate": "code_review"
    },
    {
      "id": "verification",
      "stage": "05-verification",
      "title": "验证证据",
      "description": "验收测试报告",
      "outputs": [
        "05-verification/report.md",
        "05-verification/ci-result.md"
      ],
      "requires": [
        "code_review"
      ],
      "gate": "verification"
    },
    {
      "id": "ssot_sync",
      "stage": "06-closure",
      "title": "长期知识回流",
      "description": "更新长期知识",
      "outputs": [
        "06-closure/ssot-sync.md"
      ],
      "requires": [
        "verification"
      ],
      "gate": "ssot_sync"
    },
    {
      "id": "closure",
      "stage": "06-closure",
      "title": "关闭记录",
      "description": "归档与上线",
      "outputs": [
        "06-closure/release.md",
        "06-closure/rollback.md"
      ],
      "requires": [
        "ssot_sync"
      ]
    }
  ],
  "apply": {
    "requires": [
      "tasks",
      "spec_review"
    ],
    "tracks": "01-spec/tasks.md"
  },
  "archive": {
    "requires": [
      "verification",
      "ssot_sync",
      "closure"
    ]
  }
}
