{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huangrx6/SpecForge/core/skills/quality/test-engineering/contracts/playwright-flow.schema.json",
  "title": "SpecForge Playwright Flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "source_test_case", "base_url", "auth_strategy", "roles", "preconditions", "route", "steps", "locators_required", "screenshots", "trace", "headed_demo", "cleanup"],
  "properties": {
    "id": { "type": "string", "pattern": "^PW-[0-9]{3,}$" },
    "title": { "type": "string" },
    "source_test_case": { "type": "string" },
    "base_url": { "type": "string" },
    "auth_strategy": { "type": "string", "enum": ["none", "ui-login", "api-login", "storage-state", "manual"] },
    "roles": { "type": "array", "items": { "type": "string" } },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "route": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "target", "value", "assertion"],
        "properties": {
          "action": { "type": "string", "enum": ["goto", "click", "fill", "select", "upload", "download", "assert", "wait"] },
          "target": { "type": "string" },
          "value": { "type": "string" },
          "assertion": { "type": "string" }
        }
      }
    },
    "locators_required": { "type": "array", "items": { "type": "string" } },
    "screenshots": { "type": "array", "items": { "type": "string" } },
    "trace": { "type": "string", "enum": ["on", "retain-on-failure", "on-first-retry"] },
    "headed_demo": { "type": "boolean" },
    "cleanup": { "type": "array", "items": { "type": "string" } }
  }
}
