{
  "version": 1,
  "description": "SpecForge starter 生成清单。根 .specforge 是母本；starter 是按本清单生成的发行快照。",
  "copy": [
    "AGENTS.md",
    "PROTOCOL.md",
    "attention.md",
    "manifest.yaml",
    "starter.manifest.json",
    "adapters",
    "agents",
    "commands",
    "rules",
    "schemas",
    "skills",
    "templates",
    "workflows",
    "tools/archive-change.mjs",
    "tools/artifact-graph-status.md",
    "tools/artifact-graph-status.mjs",
    "tools/create-artifact.mjs",
    "tools/create-change.mjs",
    "tools/doctor.mjs",
    "tools/gate.mjs",
    "tools/instructions.mjs",
    "tools/self-test.mjs",
    "tools/status.mjs",
    "tools/validate-structure.mjs",
    "tools/lib"
  ],
  "directories": [
    "changes/inbox",
    "changes/active",
    "changes/archive",
    "knowledge/decisions"
  ],
  "files": {
    "registry.yaml": "active: []\nblocked: []\narchive: []\n",
    "changes/inbox/.gitkeep": "",
    "changes/active/.gitkeep": "",
    "changes/archive/.gitkeep": "",
    "knowledge/README.md": "# 项目知识库\n\n这里只记录跨 change 长期有效的事实。临时讨论、实现过程和验证证据放在 `.specforge/changes/`。\n",
    "knowledge/product.md": "# 产品事实\n\n暂无。\n",
    "knowledge/architecture.md": "# 架构事实\n\n暂无。\n",
    "knowledge/glossary.md": "# 术语表\n\n暂无。\n",
    "knowledge/risks.md": "# 风险与技术债\n\n暂无。\n",
    "knowledge/decisions/.gitkeep": ""
  }
}
