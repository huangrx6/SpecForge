{
  "id": "discovery",
  "version": 1,
  "description": "探索与技术预研流程，仅输出研究成果，不实施代码。",
  "artifacts": [
    {
      "id": "intake",
      "stage": "00-intake",
      "title": "预研入口",
      "description": "记录调研目标",
      "outputs": [
        "00-intake/original-request.md",
        "00-intake/brief.md"
      ],
      "requires": []
    },
    {
      "id": "research",
      "stage": "01-spec",
      "title": "调研报告",
      "description": "实验记录与可行性分析",
      "outputs": [
        "01-spec/research.md"
      ],
      "requires": [
        "intake"
      ]
    },
    {
      "id": "ssot_sync",
      "stage": "06-closure",
      "title": "知识回流",
      "description": "提炼入项目知识库",
      "outputs": [
        "06-closure/ssot-sync.md"
      ],
      "requires": [
        "research"
      ],
      "gate": "ssot_sync"
    },
    {
      "id": "closure",
      "stage": "06-closure",
      "title": "关闭记录",
      "description": "归档",
      "outputs": [
        "06-closure/release.md",
        "06-closure/rollback.md"
      ],
      "requires": [
        "ssot_sync"
      ]
    }
  ],
  "apply": {
    "requires": [],
    "tracks": null
  },
  "archive": {
    "requires": [
      "ssot_sync",
      "closure"
    ]
  }
}
