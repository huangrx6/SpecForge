{
  "id": "lite",
  "version": 1,
  "description": "轻量级流程，跳过 design 和 spec_review，适合小改动。",
  "artifacts": [
    {
      "id": "intake",
      "stage": "00-intake",
      "title": "需求入口",
      "description": "记录请求背景",
      "outputs": [
        "00-intake/original-request.md",
        "00-intake/brief.md"
      ],
      "requires": []
    },
    {
      "id": "requirements",
      "stage": "01-spec",
      "title": "需求规格",
      "description": "简要行为边界",
      "outputs": [
        "01-spec/requirements.md"
      ],
      "requires": [
        "intake"
      ]
    },
    {
      "id": "tasks",
      "stage": "01-spec",
      "title": "任务拆解",
      "description": "直接基于需求拆分任务",
      "outputs": [
        "01-spec/tasks.md"
      ],
      "requires": [
        "requirements"
      ]
    },
    {
      "id": "implementation",
      "stage": "03-implementation",
      "title": "实现记录",
      "description": "记录变更",
      "outputs": [
        "03-implementation/plan.md",
        "03-implementation/report.md",
        "03-implementation/changed-files.md"
      ],
      "requires": [
        "tasks"
      ]
    },
    {
      "id": "code_review",
      "stage": "04-code-review",
      "title": "代码审查",
      "description": "确认代码质量",
      "outputs": [
        "04-code-review/code-review-v1.md"
      ],
      "requires": [
        "implementation"
      ],
      "gate": "code_review"
    },
    {
      "id": "verification",
      "stage": "05-verification",
      "title": "验证证据",
      "description": "确认有效性",
      "outputs": [
        "05-verification/test-cases.md",
        "05-verification/report.md",
        "05-verification/ci-result.md"
      ],
      "requires": [
        "code_review"
      ],
      "gate": "verification"
    },
    {
      "id": "wiki_sync",
      "stage": "06-close",
      "title": "知识回流",
      "description": "更新长期知识",
      "outputs": [
        "06-close/wiki-sync.md"
      ],
      "requires": [
        "verification"
      ],
      "gate": "wiki_sync"
    },
    {
      "id": "closure",
      "stage": "06-close",
      "title": "关闭记录",
      "description": "归档",
      "outputs": [
        "06-close/release.md",
        "06-close/rollback.md"
      ],
      "requires": [
        "wiki_sync"
      ]
    }
  ],
  "apply": {
    "requires": [
      "tasks"
    ],
    "tracks": "01-spec/tasks.md"
  },
  "archive": {
    "requires": [
      "verification",
      "wiki_sync",
      "closure"
    ]
  },
  "traceability_policy": {
    "mode": "advisory",
    "enforced_gates": []
  },
  "quality_policy": {
    "section_checks": [
      {
        "artifact": "requirements",
        "path": "01-spec/requirements.md",
        "sections": [
          "Spec Quality Gate",
          "需求一致性检查"
        ],
        "severity": "P2",
        "message": "requirements.md 缺少质量门禁或一致性检查，后续设计可能仍要重新判断冲突和可测试性。"
      },
      {
        "artifact": "tasks",
        "path": "01-spec/tasks.md",
        "sections": [
          "一页摘要",
          "任务图与执行策略"
        ],
        "severity": "P2",
        "message": "tasks.md 缺少任务图与执行策略，多 agent / 并行实现时容易产生写入边界冲突。"
      },
      {
        "artifact": "implementation",
        "path": "03-implementation/report.md",
        "sections": [
          "任务图执行对账"
        ],
        "severity": "P2",
        "message": "implementation report 缺少任务图执行对账，code review 难以判断实际实现顺序和并行边界是否符合 tasks。"
      },
      {
        "artifact": "code_review",
        "path": "04-code-review/code-review-v1.md",
        "sections": [
          "Review Control",
          "Diff Reconciliation",
          "Verification Notes"
        ],
        "severity": "P2",
        "message": "code review 缺少 review control、diff reconciliation 或 verification notes，verification 可能拿不到真实 diff 范围、弱证据、deferred 项和外部补证提示。"
      },
      {
        "artifact": "verification",
        "path": "05-verification/report.md",
        "sections": [
          "一页摘要",
          "证据强度分级",
          "人工确认与外部补证"
        ],
        "severity": "P2",
        "message": "verification report 缺少证据强度分级或人工确认记录，gate 风险接受依据不够清楚。"
      },
      {
        "artifact": "wiki_sync",
        "path": "06-close/wiki-sync.md",
        "sections": [
          "派生报告索引"
        ],
        "severity": "P3",
        "message": "wiki-sync.md 缺少派生报告索引，HTML / 图表等辅助产物的后续追踪可能不完整。"
      },
      {
        "artifact": "closure",
        "path": "06-close/release.md",
        "sections": [
          "外部补证与派生报告"
        ],
        "severity": "P3",
        "message": "release.md 缺少外部补证与派生报告记录，manual-confirmed / deferred 项可能没有发布后观察承接。"
      }
    ]
  }
}
