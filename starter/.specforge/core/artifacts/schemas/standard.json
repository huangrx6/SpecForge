{
  "id": "standard",
  "version": 1,
  "description": "标准 SpecForge 变更流程：从 intake 到 Wiki 同步的 artifact 依赖图。",
  "artifacts": [
    {
      "id": "intake",
      "stage": "00-intake",
      "title": "需求入口",
      "description": "记录原始请求、背景、目标、边界候选和下一步路线。",
      "outputs": [
        "00-intake/original-request.md",
        "00-intake/brief.md"
      ],
      "requires": []
    },
    {
      "id": "research",
      "stage": "01-spec",
      "title": "外部研究",
      "description": "当 intake 标记 needs_research 时，先沉淀官方资料、第三方约束、PoC 或方案调研，再进入 requirements。",
      "condition": "needs_research",
      "outputs": [
        "01-spec/research.md"
      ],
      "requires": [
        "intake"
      ]
    },
    {
      "id": "requirements",
      "stage": "01-spec",
      "title": "需求规格",
      "description": "沉淀用户可观察行为、范围边界和验收标准。",
      "outputs": [
        "01-spec/requirements.md"
      ],
      "requires": [
        "intake",
        "research"
      ]
    },
    {
      "id": "ui_design",
      "stage": "01-spec",
      "title": "体验与界面设计",
      "description": "把 UI/UX 影响转成视觉风格确认、页面地图、用户流程、交互状态和可验收原型；无 UI 影响时写明 N/A 和理由。",
      "condition": "has_ui",
      "outputs": [
        "01-spec/ui-design.md"
      ],
      "requires": [
        "requirements"
      ]
    },
    {
      "id": "technical_design",
      "stage": "01-spec",
      "title": "技术架构设计",
      "description": "把技术影响转成前后端架构、接口、数据、权限、配置、NFR、失败模式和验证策略。",
      "condition": {
        "any": [
          "has_api",
          "has_db",
          "has_domain",
          "has_ai",
          "has_nfr",
          "has_security",
          "has_integration",
          "has_infra",
          "has_background_job"
        ]
      },
      "outputs": [
        "01-spec/technical-design.md"
      ],
      "requires": [
        "requirements"
      ]
    },
    {
      "id": "tasks",
      "stage": "01-spec",
      "title": "任务拆解",
      "description": "把设计拆成可执行、可验证、可并行判断的任务图。",
      "outputs": [
        "01-spec/tasks.md"
      ],
      "requires": [
        "ui_design",
        "technical_design"
      ]
    },
    {
      "id": "spec_review",
      "stage": "02-spec-review",
      "title": "规格审查",
      "description": "确认需求、设计、任务和边界足以进入实现。",
      "outputs": [
        "02-spec-review/spec-review-v1.md"
      ],
      "requires": [
        "requirements",
        "ui_design",
        "technical_design",
        "tasks"
      ],
      "gate": "spec_review"
    },
    {
      "id": "implementation",
      "stage": "03-implementation",
      "title": "实现记录",
      "description": "记录实现计划、实际变更和变更文件。",
      "outputs": [
        "03-implementation/plan.md",
        "03-implementation/report.md",
        "03-implementation/changed-files.md"
      ],
      "requires": [
        "spec_review"
      ]
    },
    {
      "id": "code_review",
      "stage": "04-code-review",
      "title": "代码审查",
      "description": "确认实现没有偏离规格、边界、安全和工程规则。",
      "outputs": [
        "04-code-review/code-review-v1.md"
      ],
      "requires": [
        "implementation"
      ],
      "gate": "code_review"
    },
    {
      "id": "verification",
      "stage": "05-verification",
      "title": "验证证据",
      "description": "记录测试、构建、手工验证、日志或其他可追溯证据。",
      "outputs": [
        "05-verification/report.md",
        "05-verification/ci-result.md"
      ],
      "requires": [
        "code_review"
      ],
      "gate": "verification"
    },
    {
      "id": "wiki_sync",
      "stage": "06-close",
      "title": "长期知识回流",
      "description": "确认长期项目知识已更新，或明确说明本次变更不影响 Wiki。",
      "outputs": [
        "06-close/wiki-sync.md"
      ],
      "requires": [
        "verification"
      ],
      "gate": "wiki_sync"
    },
    {
      "id": "closure",
      "stage": "06-close",
      "title": "关闭记录",
      "description": "记录发布、回滚和归档前结论，让变更具备可关闭证据。",
      "outputs": [
        "06-close/release.md",
        "06-close/rollback.md"
      ],
      "requires": [
        "wiki_sync"
      ]
    }
  ],
  "apply": {
    "requires": [
      "tasks",
      "spec_review"
    ],
    "tracks": "01-spec/tasks.md"
  },
  "archive": {
    "requires": [
      "verification",
      "wiki_sync",
      "closure"
    ]
  },
  "quality_policy": {
    "section_checks": [
      {
        "artifact": "research",
        "path": "01-spec/research.md",
        "sections": [
          "来源质量分级",
          "ADR 摘要"
        ],
        "severity": "P2",
        "message": "research.md 缺少来源质量分级或 ADR 摘要，后续方案可能无法区分官方证据、推断和长期决策。"
      },
      {
        "artifact": "requirements",
        "path": "01-spec/requirements.md",
        "sections": [
          "Spec Quality Gate",
          "需求一致性检查"
        ],
        "severity": "P2",
        "message": "requirements.md 缺少质量门禁或一致性检查，后续设计可能仍要重新判断冲突和可测试性。"
      },
      {
        "artifact": "ui_design",
        "path": "01-spec/ui-design.md",
        "sections": [
          "一页摘要",
          "Interaction State Matrix",
          "Pencil 原型证据"
        ],
        "severity": "P2",
        "message": "ui-design.md 缺少交互状态矩阵或原型证据，页面实现和验收可能覆盖不到空态、错误态、权限和关键截图。"
      },
      {
        "artifact": "technical_design",
        "path": "01-spec/technical-design.md",
        "sections": [
          "一页摘要",
          "Design Quality Gate",
          "架构决策记录"
        ],
        "severity": "P2",
        "message": "technical-design.md 缺少设计质量门禁或 ADR 摘要，任务拆解时可能缺少最小充分设计和长期决策依据。"
      },
      {
        "artifact": "tasks",
        "path": "01-spec/tasks.md",
        "sections": [
          "一页摘要",
          "任务图与执行策略"
        ],
        "severity": "P2",
        "message": "tasks.md 缺少任务图与执行策略，多 agent / 并行实现时容易产生写入边界冲突。"
      },
      {
        "artifact": "spec_review",
        "path": "02-spec-review/spec-review-v1.md",
        "sections": [
          "一页摘要",
          "Traceability Matrix",
          "Artifact Quality Review"
        ],
        "severity": "P2",
        "message": "spec review 缺少追溯矩阵或 artifact 质量审查，进入实现前可能仍有需求、设计、任务断链。"
      },
      {
        "artifact": "implementation",
        "path": "03-implementation/report.md",
        "sections": [
          "任务图执行对账"
        ],
        "severity": "P2",
        "message": "implementation report 缺少任务图执行对账，code review 难以判断实际实现顺序和并行边界是否符合 tasks。"
      },
      {
        "artifact": "code_review",
        "path": "04-code-review/code-review-v1.md",
        "sections": [
          "一页摘要",
          "任务图对账",
          "验证提示"
        ],
        "severity": "P2",
        "message": "code review 缺少任务图对账或验证提示，verification 可能拿不到弱证据、deferred 项和外部补证提示。"
      },
      {
        "artifact": "verification",
        "path": "05-verification/report.md",
        "sections": [
          "一页摘要",
          "证据强度分级",
          "人工确认与外部补证"
        ],
        "severity": "P2",
        "message": "verification report 缺少证据强度分级或人工确认记录，gate 风险接受依据不够清楚。"
      },
      {
        "artifact": "wiki_sync",
        "path": "06-close/wiki-sync.md",
        "sections": [
          "派生报告索引"
        ],
        "severity": "P3",
        "message": "wiki-sync.md 缺少派生报告索引，HTML / 图表等辅助产物的后续追踪可能不完整。"
      },
      {
        "artifact": "closure",
        "path": "06-close/release.md",
        "sections": [
          "外部补证与派生报告"
        ],
        "severity": "P3",
        "message": "release.md 缺少外部补证与派生报告记录，manual-confirmed / deferred 项可能没有发布后观察承接。"
      }
    ]
  }
}
