{
  "id": "refactor",
  "version": 1,
  "description": "重构流程，跳过业务需求(Requirements)，专注 technical_design 和实施。",
  "artifacts": [
    {
      "id": "intake",
      "stage": "00-intake",
      "title": "重构入口",
      "description": "记录重构动机",
      "outputs": [
        "00-intake/original-request.md",
        "00-intake/brief.md"
      ],
      "requires": []
    },
    {
      "id": "technical_design",
      "stage": "01-spec",
      "title": "技术设计",
      "description": "重构的架构与解耦方案",
      "outputs": [
        "01-spec/technical-design.md"
      ],
      "requires": [
        "intake"
      ]
    },
    {
      "id": "tasks",
      "stage": "01-spec",
      "title": "任务拆解",
      "description": "重构实施步骤",
      "outputs": [
        "01-spec/tasks.md"
      ],
      "requires": [
        "technical_design"
      ]
    },
    {
      "id": "spec_review",
      "stage": "02-spec-review",
      "title": "架构审查",
      "description": "评审重构方案风险",
      "outputs": [
        "02-spec-review/spec-review-v1.md"
      ],
      "requires": [
        "technical_design",
        "tasks"
      ],
      "gate": "spec_review"
    },
    {
      "id": "implementation",
      "stage": "03-implementation",
      "title": "实现记录",
      "description": "记录重构变更",
      "outputs": [
        "03-implementation/plan.md",
        "03-implementation/report.md",
        "03-implementation/changed-files.md"
      ],
      "requires": [
        "spec_review"
      ]
    },
    {
      "id": "code_review",
      "stage": "04-code-review",
      "title": "代码审查",
      "description": "确认代码重构达成目标",
      "outputs": [
        "04-code-review/code-review-v1.md"
      ],
      "requires": [
        "implementation"
      ],
      "gate": "code_review"
    },
    {
      "id": "verification",
      "stage": "05-verification",
      "title": "验证证据",
      "description": "确认功能无回归破坏",
      "outputs": [
        "05-verification/report.md",
        "05-verification/ci-result.md"
      ],
      "requires": [
        "code_review"
      ],
      "gate": "verification"
    },
    {
      "id": "ssot_sync",
      "stage": "06-closure",
      "title": "知识回流",
      "description": "同步架构图等",
      "outputs": [
        "06-closure/ssot-sync.md"
      ],
      "requires": [
        "verification"
      ],
      "gate": "ssot_sync"
    },
    {
      "id": "closure",
      "stage": "06-closure",
      "title": "关闭记录",
      "description": "归档",
      "outputs": [
        "06-closure/release.md",
        "06-closure/rollback.md"
      ],
      "requires": [
        "ssot_sync"
      ]
    }
  ],
  "apply": {
    "requires": [
      "tasks",
      "spec_review"
    ],
    "tracks": "01-spec/tasks.md"
  },
  "archive": {
    "requires": [
      "verification",
      "ssot_sync",
      "closure"
    ]
  }
}
