{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huangrx6/SpecForge/core/skills/ui-ux/design-system/contracts/design-contract.schema.json",
  "title": "SpecForge Design Contract Summary",
  "$comment": "reference_selection is optional for backward compatibility. If scan_manifest.workflow contains \"reference\", or design-system handled external reference sources, the artifact should include reference_selection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scan_manifest",
    "design_mode",
    "aesthetic_direction",
    "human_confirmation",
    "signature",
    "color_system",
    "foundation_system",
    "token_source",
    "token_delivery_hint",
    "component_strategy",
    "shadcn_vue",
    "motion",
    "visual_qa",
    "verification_hooks",
    "anti_slop_rules"
  ],
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "hexOrAlphaHex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
    },
    "selectionRationaleItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "why", "rejected", "risk", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "rejected": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "risk": { "type": "string", "minLength": 1 },
        "confidence": {
          "type": "string",
          "enum": ["confirmed", "likely", "unclear"]
        },
        "license": { "type": "string" }
      }
    },
    "visualQaItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detector", "result", "severity", "evidence", "fix", "status", "owner"],
      "properties": {
        "detector": { "type": "string", "minLength": 1 },
        "result": {
          "type": "string",
          "enum": ["ok", "issue", "not-applicable"]
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "viewport", "region"],
          "properties": {
            "artifact": { "type": "string", "minLength": 1 },
            "viewport": { "type": "string", "minLength": 1 },
            "region": { "type": "string", "minLength": 1 }
          }
        },
        "fix": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["fixed", "accepted", "pending", "blocked", "not-applicable"]
        },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "referenceSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ui_type",
        "stack",
        "selected_needs",
        "borrow_strength",
        "source_routing",
        "reuse_boundary",
        "offline_behavior",
        "human_confirmation",
        "forbidden"
      ],
      "properties": {
        "ui_type": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "admin",
              "data-table",
              "dashboard",
              "settings",
              "auth",
              "onboarding",
              "ai-assistant",
              "brand-surface",
              "mobile-h5",
              "empty-state"
            ]
          }
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vue",
              "shadcn-vue",
              "react",
              "shadcn-ui",
              "tailwind",
              "element-plus",
              "existing-component-library",
              "unknown"
            ]
          }
        },
        "selected_needs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "component-wrapper",
              "page-structure",
              "block-composition",
              "visual-completion",
              "motion",
              "domestic-ui-case",
              "industry-case",
              "ux-ia",
              "state-system"
            ]
          }
        },
        "borrow_strength": {
          "type": "string",
          "enum": [
            "conservative",
            "moderate",
            "strong",
            "review-only"
          ]
        },
        "admin_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "app-shell",
              "dashboard",
              "data-table",
              "chart-metrics",
              "form-flow",
              "user-permission",
              "settings",
              "auth",
              "feedback-overlays",
              "state-system"
            ]
          }
        },
        "visual_direction": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "clean-professional",
              "high-density-efficient",
              "light-brand",
              "tech-without-ai-neon",
              "domestic-internet-product",
              "portfolio-level-polish",
              "warm-friendly",
              "dark-professional"
            ]
          }
        },
        "source_routing": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selected_need",
              "source_pool",
              "use_for",
              "reuse_mode",
              "required_extraction",
              "avoid"
            ],
            "properties": {
              "selected_need": {
                "type": "string"
              },
              "source_pool": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "use_for": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reuse_mode": {
                "type": "string",
                "enum": [
                  "component-contract-only",
                  "pattern-only",
                  "page-pattern-only",
                  "inspiration-only",
                  "method-only",
                  "implementation-reference",
                  "translate-to-vue-contract"
                ]
              },
              "required_extraction": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "avoid": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "offline_fallback": {
                "type": "string"
              }
            }
          }
        },
        "reuse_boundary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "offline_behavior": {
          "type": "string"
        },
        "human_confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "confirmed",
                "defaulted",
                "pending"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "creativeDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "why", "alternatives", "rejected_defaults", "signature_carrier"],
      "properties": {
        "selected": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "positioning", "fit", "risk"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "positioning": { "type": "string", "minLength": 1 },
              "fit": { "type": "string", "minLength": 1 },
              "risk": { "type": "string", "minLength": 1 }
            }
          }
        },
        "rejected_defaults": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "signature_carrier": {
          "type": "string",
          "enum": ["structure", "typography", "asset", "motion", "material", "interaction", "mixed"]
        }
      }
    },
    "referenceEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "access", "viewport", "observed", "borrowed", "rejected", "confidence"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string" },
          "access": {
            "type": "string",
            "enum": ["catalog", "static", "scroll", "interactive", "comparative", "offline-fallback"]
          },
          "viewport": { "type": "string", "minLength": 1 },
          "observed": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "borrowed": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "rejected": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "confidence": {
            "type": "string",
            "enum": ["confirmed", "likely", "unclear"]
          }
        }
      }
    },
    "assetManifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target_path", "purpose", "prompt_or_source", "placement", "required", "license_note"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["image", "illustration", "icon", "3d-model", "video", "texture", "lottie", "audio"]
          },
          "target_path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "prompt_or_source": { "type": "string", "minLength": 1 },
          "placement": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "license_note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "interactionSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "trigger", "technique", "motion_blocks", "fallback", "verification"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "technique": {
          "type": "string",
          "enum": ["css", "motion-vue", "gsap", "three", "canvas", "webgl", "mixed"]
        },
        "motion_blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fallback": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 },
        "reduced_motion": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["human_confirmation"],
        "properties": {
          "human_confirmation": {
            "required": ["required"],
            "properties": {
              "required": { "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "human_confirmation": {
            "properties": {
              "options_presented": { "minItems": 2 },
              "status": {
                "enum": ["confirmed", "pending"]
              },
              "reason": { "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["human_confirmation"],
        "properties": {
          "human_confirmation": {
            "required": ["required"],
            "properties": {
              "required": { "const": false }
            }
          }
        }
      },
      "then": {
        "properties": {
          "human_confirmation": {
            "properties": {
              "status": {
                "enum": ["confirmed", "defaulted"]
              },
              "default_reversibility": { "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["design_mode"],
        "properties": {
          "design_mode": { "const": "Product UI" }
        }
      },
      "then": {
        "required": ["layout", "state_matrix", "product_ui_quality"],
        "properties": {
          "layout": {
            "required": ["primary_work_surface"],
            "properties": {
              "primary_work_surface": { "minLength": 1 }
            }
          },
          "product_ui_quality": {
            "required": ["primary_user", "primary_object", "primary_job"],
            "properties": {
              "primary_user": { "minLength": 1 },
              "primary_object": { "minLength": 1 },
              "primary_job": { "minLength": 1 }
            }
          },
          "verification_hooks": { "minItems": 1 },
          "anti_slop_rules": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "required": ["design_mode"],
        "properties": {
          "design_mode": { "const": "Hybrid" }
        }
      },
      "then": {
        "required": ["layout", "state_matrix", "product_ui_quality"],
        "properties": {
          "layout": {
            "required": ["primary_work_surface"],
            "properties": {
              "primary_work_surface": { "minLength": 1 }
            }
          },
          "product_ui_quality": {
            "required": ["primary_user", "primary_object", "primary_job"],
            "properties": {
              "primary_user": { "minLength": 1 },
              "primary_object": { "minLength": 1 },
              "primary_job": { "minLength": 1 }
            }
          },
          "verification_hooks": { "minItems": 1 },
          "anti_slop_rules": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "required": ["design_mode"],
        "properties": {
          "design_mode": { "const": "Brand Surface" }
        }
      },
      "then": {
        "required": ["layout", "motion"],
        "properties": {
          "signature": {
            "properties": {
              "type": {
                "enum": ["typographic", "material", "motion"]
              }
            }
          },
          "motion": {
            "required": ["reduced_motion"],
            "properties": {
              "reduced_motion": { "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["design_mode"],
        "properties": {
          "design_mode": {
            "enum": ["Avatar-IP", "Empty State"]
          }
        }
      },
      "then": {
        "required": ["scope"],
        "properties": {
          "token_source": {
            "enum": ["existing", "delta"]
          },
          "anti_slop_rules": { "minItems": 1 }
        }
      }
    }
  ],
  "properties": {
    "reference_selection": {
      "description": "Optional for backward compatibility. Required by the design-system process whenever external reference sources were handled; recommended whenever scan_manifest.workflow contains \"reference\".",
      "$ref": "#/$defs/referenceSelection"
    },
    "creative_direction": {
      "description": "Optional for backward compatibility. Required by the design-system process for non-local design work to prevent default admin shells and stale visual directions.",
      "$ref": "#/$defs/creativeDirection"
    },
    "reference_evidence": {
      "description": "Optional for backward compatibility. Required when scan_manifest.workflow contains live_reference or external site/template evidence was evaluated.",
      "$ref": "#/$defs/referenceEvidence"
    },
    "asset_manifest": {
      "description": "Optional for backward compatibility. Required when custom images, 3D, texture, video, Lottie, icons or other generated assets are needed.",
      "$ref": "#/$defs/assetManifest"
    },
    "interaction_signature": {
      "description": "Optional for backward compatibility. Required when the design uses a signature motion / GSAP / Three.js / canvas interaction beyond normal Product UI feedback.",
      "$ref": "#/$defs/interactionSignature"
    },
    "scan_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "workflow", "scanned_files", "selected_data", "selection_rationale", "skipped_with_reason"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "local-component",
            "product-page",
            "brand-surface",
            "visual-calibration",
            "full-system"
          ]
        },
        "workflow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "creative_direction",
              "mode",
              "reference",
              "live_reference",
              "intelligence",
              "source",
              "font",
              "color",
              "composition",
              "asset_brief",
              "advanced_interaction",
              "interaction_signature",
              "product_ui_signature",
              "component",
              "qa",
              "calibration",
              "output"
            ]
          }
        },
        "scanned_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "purpose", "status", "finding"],
            "properties": {
              "path": { "type": "string" },
              "purpose": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["scanned", "skipped", "blocked"]
              },
              "finding": { "type": "string" }
            }
          }
        },
        "selected_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "palette_id",
            "font_source_id",
            "font_pairing_id",
            "type_scale_id",
            "spacing_density_id",
            "radius_shadow_recipe_id",
            "motion_recipe_id",
            "advanced_interaction_recipe_id"
          ],
          "properties": {
            "palette_id": { "type": "string" },
            "font_source_id": { "type": "string" },
            "font_pairing_id": { "type": "string" },
            "type_scale_id": { "type": "string" },
            "spacing_density_id": { "type": "string" },
            "radius_shadow_recipe_id": { "type": "string" },
            "motion_recipe_id": { "type": "string" },
            "advanced_interaction_recipe_id": { "type": "string" }
          }
        },
        "selection_rationale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "palette",
            "font_source",
            "font_pairing",
            "type_scale",
            "spacing_density",
            "radius_shadow",
            "motion",
            "advanced_interaction"
          ],
          "properties": {
            "palette": { "$ref": "#/$defs/selectionRationaleItem" },
            "font_source": { "$ref": "#/$defs/selectionRationaleItem" },
            "font_pairing": { "$ref": "#/$defs/selectionRationaleItem" },
            "type_scale": { "$ref": "#/$defs/selectionRationaleItem" },
            "spacing_density": { "$ref": "#/$defs/selectionRationaleItem" },
            "radius_shadow": { "$ref": "#/$defs/selectionRationaleItem" },
            "motion": { "$ref": "#/$defs/selectionRationaleItem" },
            "advanced_interaction": { "$ref": "#/$defs/selectionRationaleItem" }
          }
        },
        "skipped_with_reason": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "design_mode": {
      "type": "string",
      "enum": ["Product UI", "Brand Surface", "Hybrid", "Avatar-IP", "Empty State"]
    },
    "scope": {
      "type": "string",
      "enum": ["avatar", "empty_state", "both"]
    },
    "aesthetic_direction": {
      "type": "string"
    },
    "human_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason", "options_presented", "selected", "status", "default_reversibility"],
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": "string" },
        "options_presented": {
          "type": "array",
          "items": { "type": "string" }
        },
        "selected": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["confirmed", "defaulted", "pending"]
        },
        "default_reversibility": { "type": "string" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["structural", "typographic", "material", "interaction", "motion"]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "token_source": {
      "type": "string",
      "enum": ["existing", "new", "delta"]
    },
    "token_delivery_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["css_variables", "tailwind_mapping", "pencil_variables", "notes"],
      "properties": {
        "css_variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^--[A-Za-z0-9_-]+$"
          }
        },
        "tailwind_mapping": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "pencil_variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "color_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette_id",
        "aesthetic_direction",
        "design_mode",
        "tokens",
        "usage_rules",
        "accessibility",
        "source",
        "source_url",
        "license_note"
      ],
      "properties": {
        "palette_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "aesthetic_direction": { "type": "string", "minLength": 1 },
        "design_mode": {
          "type": "string",
          "enum": ["Product UI", "Brand Surface", "Hybrid", "Avatar-IP", "Empty State"]
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "surface",
            "surface_muted",
            "text",
            "text_muted",
            "primary",
            "secondary",
            "accent",
            "border",
            "success",
            "warning",
            "danger",
            "chart"
          ],
          "properties": {
            "background": { "$ref": "#/$defs/hex" },
            "surface": { "$ref": "#/$defs/hexOrAlphaHex" },
            "surface_muted": { "$ref": "#/$defs/hexOrAlphaHex" },
            "text": { "$ref": "#/$defs/hex" },
            "text_muted": { "$ref": "#/$defs/hex" },
            "primary": { "$ref": "#/$defs/hex" },
            "secondary": { "$ref": "#/$defs/hexOrAlphaHex" },
            "accent": { "$ref": "#/$defs/hex" },
            "border": { "$ref": "#/$defs/hexOrAlphaHex" },
            "success": { "$ref": "#/$defs/hex" },
            "warning": { "$ref": "#/$defs/hex" },
            "danger": { "$ref": "#/$defs/hex" },
            "chart": {
              "type": "array",
              "minItems": 3,
              "items": { "$ref": "#/$defs/hex" }
            }
          }
        },
        "usage_rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_usage", "accent_usage", "background_usage", "avoid"],
          "properties": {
            "primary_usage": { "type": "string", "minLength": 1 },
            "accent_usage": { "type": "string", "minLength": 1 },
            "background_usage": { "type": "string", "minLength": 1 },
            "avoid": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "accessibility": {
          "type": "object",
