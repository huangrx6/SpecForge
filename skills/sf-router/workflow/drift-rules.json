{
  "version": 1,
  "description": "Canonical terminology and gate evidence rules shared by public sf-* skills, core workflow stage skills, and framework audit.",
  "gate_rules": [
    {
      "gate": "spec_review",
      "artifact": "spec_review",
      "stage": "spec-review",
      "public_skill": "sf-spec-review",
      "evidence": "02-spec-review/spec-review-v1.md",
      "approved_command": "node .specforge/core/scripts/gate.mjs spec_review APPROVED --evidence 02-spec-review/spec-review-v1.md",
      "purpose": "Approve the full spec package before implementation."
    },
    {
      "gate": "code_review",
      "artifact": "code_review",
      "stage": "code-review",
      "public_skill": "sf-code-review",
      "evidence": "04-code-review/code-review-v1.md",
      "approved_command": "node .specforge/core/scripts/gate.mjs code_review APPROVED --evidence 04-code-review/code-review-v1.md",
      "purpose": "Approve implementation quality before verification."
    },
    {
      "gate": "verification",
      "artifact": "verification",
      "stage": "verification",
      "public_skill": "sf-verify",
      "evidence": "05-verification/report.md",
      "approved_command": "node .specforge/core/scripts/gate.mjs verification APPROVED --evidence 05-verification/report.md",
      "purpose": "Approve behavior and release evidence."
    },
    {
      "gate": "wiki_sync",
      "artifact": "wiki_sync",
      "stage": "wiki-sync",
      "public_skill": "sf-wiki",
      "evidence": "06-close/wiki-sync.md",
      "approved_command": "node .specforge/core/scripts/gate.mjs wiki_sync APPROVED --evidence 06-close/wiki-sync.md",
      "purpose": "Approve long-lived knowledge sync before closure."
    }
  ],
  "artifact_terms": [
    {
      "artifact": "requirements",
      "stage": "requirements",
      "public_skill": "sf-requirements",
      "output": "01-spec/requirements.md"
    },
    {
      "artifact": "ui_design",
      "stage": "ui-design",
      "public_skill": "sf-ui-design",
      "output": "01-spec/ui-design.md"
    },
    {
      "artifact": "technical_design",
      "stage": "technical-design",
      "public_skill": "sf-tech-design",
      "output": "01-spec/technical-design.md"
    },
    {
      "artifact": "tasks",
      "stage": "task-planning",
      "public_skill": "sf-tasking",
      "output": "01-spec/tasks.md"
    },
    {
      "artifact": "implementation",
      "stage": "implementation",
      "public_skill": "sf-implement",
      "output": "03-implementation/report.md"
    },
    {
      "artifact": "code_review",
      "stage": "code-review",
      "public_skill": "sf-code-review",
      "output": "04-code-review/code-review-v1.md"
    },
    {
      "artifact": "verification",
      "stage": "verification",
      "public_skill": "sf-verify",
      "output": "05-verification/report.md"
    },
    {
      "artifact": "wiki_sync",
      "stage": "wiki-sync",
      "public_skill": "sf-wiki",
      "output": "06-close/wiki-sync.md"
    }
  ],
  "anti_drift_rules": [
    {
      "id": "public-skill-must-link-core-stage",
      "severity": "FAIL",
      "rule": "Every gate public skill must mention its core stage skill path."
    },
    {
      "id": "gate-evidence-single-source",
      "severity": "FAIL",
      "rule": "Every gate stage skill and public skill must mention the canonical gate name and approval evidence path."
    },
    {
      "id": "catalog-stage-alignment",
      "severity": "FAIL",
      "rule": "Every artifact term must align with skills/catalog.json public_skill, primary_stage, and core_stages."
    },
    {
      "id": "approved-command-alignment",
      "severity": "WARN",
      "rule": "Every gate public skill should include the canonical APPROVED gate command exactly once."
    }
  ]
}
