{
  "id": "bugfix",
  "version": 1,
  "description": "缺陷修复流程，注重根因分析(Gap Report)而非功能需求。",
  "artifacts": [
    {
      "id": "intake",
      "stage": "00-intake",
      "title": "缺陷入口",
      "description": "记录 Bug 现象",
      "outputs": [
        "00-intake/original-request.md",
        "00-intake/brief.md"
      ],
      "requires": []
    },
    {
      "id": "gap_report",
      "stage": "01-spec",
      "title": "根因分析",
      "description": "分析为何出现缺陷及修复方案",
      "outputs": [
        "01-spec/gap-report.md"
      ],
      "requires": [
        "intake"
      ]
    },
    {
      "id": "tasks",
      "stage": "01-spec",
      "title": "修复任务",
      "description": "修复执行步骤",
      "outputs": [
        "01-spec/tasks.md"
      ],
      "requires": [
        "gap_report"
      ]
    },
    {
      "id": "implementation",
      "stage": "03-implementation",
      "title": "实现记录",
      "description": "记录变更",
      "outputs": [
        "03-implementation/plan.md",
        "03-implementation/report.md",
        "03-implementation/changed-files.md"
      ],
      "requires": [
        "tasks"
      ]
    },
    {
      "id": "code_review",
      "stage": "04-code-review",
      "title": "代码审查",
      "description": "确认代码质量",
      "outputs": [
        "04-code-review/code-review-v1.md"
      ],
      "requires": [
        "implementation"
      ],
      "gate": "code_review"
    },
    {
      "id": "verification",
      "stage": "05-verification",
      "title": "验证证据",
      "description": "复测缺陷是否被修复且无回归",
      "outputs": [
        "05-verification/report.md",
        "05-verification/ci-result.md"
      ],
      "requires": [
        "code_review"
      ],
      "gate": "verification"
    },
    {
      "id": "ssot_sync",
      "stage": "06-closure",
      "title": "知识回流",
      "description": "更新长期知识",
      "outputs": [
        "06-closure/ssot-sync.md"
      ],
      "requires": [
        "verification"
      ],
      "gate": "ssot_sync"
    },
    {
      "id": "closure",
      "stage": "06-closure",
      "title": "关闭记录",
      "description": "归档",
      "outputs": [
        "06-closure/release.md",
        "06-closure/rollback.md"
      ],
      "requires": [
        "ssot_sync"
      ]
    }
  ],
  "apply": {
    "requires": [
      "tasks"
    ],
    "tracks": "01-spec/tasks.md"
  },
  "archive": {
    "requires": [
      "verification",
      "ssot_sync",
      "closure"
    ]
  }
}
